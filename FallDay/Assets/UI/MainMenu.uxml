<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/menu-button.uss?fileID=7433441132597879392&amp;guid=5ff4fe793556fb647bf035ecb21b8114&amp;type=3#menu-button"/>
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; height: auto;">
        <ui:VisualElement name="Menu" style="flex-grow: 1; width: 100%; height: 100%; position: absolute; align-items: center;">
            <ui:Image source="project://database/Assets/UI/NewUIHud/Icons_menu/BG.png?fileID=21300000&amp;guid=8b5e1b191a602234d813cfc5864871e2&amp;type=3#BG" scale-mode="StretchToFill" name="Image" style="position: absolute; height: 100%; width: 100%; top: auto; left: auto;"/>
            <ui:VisualElement name="Title" style="flex-grow: 1; width: 90%; height: 40%; align-items: center; justify-content: space-between; align-self: center;">
                <ui:Image source="project://database/Assets/UI/NewUIHud/Icons_menu/TITLE-export.png?fileID=2800000&amp;guid=f802f93f619f0a743b2830dde1817ede&amp;type=3#TITLE-export" style="width: 100%; height: 60%; align-items: center; justify-content: space-between; align-self: center; align-content: center; top: 5%;"/>
            </ui:VisualElement>
            <ui:VisualElement name="StartArticle" style="flex-grow: 1; width: 100%; height: 15%; align-items: center; justify-content: flex-start; align-self: stretch; align-content: center;">
                <ui:Image source="project://database/Assets/UI/NewUIHud/Icons_menu/tap-export.png?fileID=2800000&amp;guid=df234e25c8b208846bddb7558c809c6d&amp;type=3#tap-export" name="Image" style="width: 100%; height: 6%; align-items: stretch; justify-content: space-around; align-self: center; align-content: stretch;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Container_Bottom" style="flex-grow: 0; position: absolute; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0); display: flex; color: rgb(0, 0, 0);">
                <ui:VisualElement name="Scrim" enabled="true" class="scrim" style="display: flex; visibility: visible; opacity: 1; align-items: center; align-self: stretch; align-content: flex-start; justify-content: center;">
                    <ui:Button text="X" name="closeMenu" class="close_menu_off" style="font-size: 130%; transition-timing-function: ease-in-bounce; width: 20%; height: 10%; top: 33%;"/>
                </ui:VisualElement>
                <ui:VisualElement name="BottomSheet" class="bottom_Sheet">
                    <ui:Button text="" name="openSound" style="align-self: flex-start; align-content: stretch; width: 19%; height: 17%; justify-content: center; align-items: center; top: 3%; left: auto; background-image: url(&quot;project://database/Assets/UI/NewUIHud/Icons_menu/BtnOff1Px.png?fileID=2800000&amp;guid=1898b563b98a8a6419a01d1bd93cc05a&amp;type=3#BtnOff1Px&quot;); background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                    <ui:Button text="" name="openConfig" style="align-self: flex-start; align-content: stretch; width: 19%; height: 17%; justify-content: center; align-items: center; top: 3%; left: auto; background-image: url(&quot;project://database/Assets/UI/NewUIHud/Icons_menu/BtnOff2Px.png?fileID=2800000&amp;guid=35c26a52b9ba28643a7e687762ec484f&amp;type=3#BtnOff2Px&quot;); background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                    <ui:Button text="" name="openEvents" style="align-self: flex-start; align-content: stretch; width: 19%; height: 17%; justify-content: center; align-items: center; top: 3%; left: auto; background-image: url(&quot;project://database/Assets/UI/NewUIHud/Icons_menu/BtnOff3Px.png?fileID=2800000&amp;guid=3b0ce90a1100280499515b87c67e1a0e&amp;type=3#BtnOff3Px&quot;); background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                    <ui:Button text="" name="openShop" style="align-self: flex-start; align-content: stretch; width: 19%; height: 17%; justify-content: center; align-items: center; top: 3%; left: auto; background-image: url(&quot;project://database/Assets/UI/NewUIHud/Icons_menu/BtnOff4Px.png?fileID=2800000&amp;guid=b8f852068c0f53743a07bf73ef6f09f9&amp;type=3#BtnOff4Px&quot;); background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; translate: 0 0%;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button text="" name="Play" icon-image="" emoji-fallback-support="false" triple-click-selects-line="false" double-click-selects-word="false" enabled="true" class="menu-button unity-base-field unity-base-slider unity-base-slider--horizontal unity-slider StartOn" style="background-color: rgba(188, 188, 188, 0); flex-direction: column; flex-wrap: nowrap; flex-shrink: 1; -unity-text-align: middle-center;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
