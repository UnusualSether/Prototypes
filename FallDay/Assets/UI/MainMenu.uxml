<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/menu-button.uss?fileID=7433441132597879392&amp;guid=5ff4fe793556fb647bf035ecb21b8114&amp;type=3#menu-button"/>
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; height: auto;">
        <ui:VisualElement name="Menu" style="flex-grow: 1; width: 100%; height: 100%; position: absolute; align-items: center;">
            <ui:Image source="project://database/Assets/UI/NewUIHud/BG.png?fileID=21300000&amp;guid=8b5e1b191a602234d813cfc5864871e2&amp;type=3#BG" scale-mode="StretchToFill" name="Image" style="position: absolute; height: 100%; width: 100%; top: auto; left: auto;"/>
            <ui:VisualElement name="Title" style="flex-grow: 1; width: 90%; height: 40%; align-items: center; justify-content: space-between; align-self: center;">
                <ui:Image source="project://database/Assets/UI/NewUIHud/TITLE-export.png?fileID=2800000&amp;guid=f802f93f619f0a743b2830dde1817ede&amp;type=3#TITLE-export" style="width: 100%; height: 60%; align-items: center; justify-content: space-between; align-self: center; align-content: center; top: 5%;"/>
            </ui:VisualElement>
            <ui:VisualElement name="StartArticle" style="flex-grow: 1; width: 100%; height: 30%; align-items: center; justify-content: center; align-self: stretch; align-content: center;">
                <ui:Image source="project://database/Assets/UI/NewUIHud/tap-export.png?fileID=2800000&amp;guid=df234e25c8b208846bddb7558c809c6d&amp;type=3#tap-export" name="Image" style="width: 100%; height: 6%; align-items: stretch; justify-content: space-around; align-self: center; align-content: stretch;">
                    <ui:Button text="" name="Play" icon-image="" class="menu-button unity-base-field unity-base-slider unity-base-slider--horizontal unity-slider" style="opacity: 1; margin-left: 4px; margin-bottom: 2px; top: auto; align-self: center; width: 100%; position: relative; left: auto; transform-origin: left top; rotate: 0; display: flex; visibility: visible; overflow: visible; -unity-background-image-tint-color: rgba(255, 255, 255, 0); background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); font-size: 100%; height: 1400%; min-height: auto; flex-direction: column; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/IndieFlower-Regular.ttf?fileID=12800000&amp;guid=2f697eda27e4046449b0b1d22608c683&amp;type=3#IndieFlower-Regular&quot;); -unity-font-style: bold; -unity-text-outline-width: 3px; -unity-text-outline-color: rgb(82, 51, 36); color: rgb(69, 40, 61); align-items: center; justify-content: center;"/>
                </ui:Image>
            </ui:VisualElement>
            <ui:VisualElement name="HudBar" style="flex-grow: 1; width: 100%; height: 30%;">
                <ui:Image source="project://database/Assets/UI/NewUIHud/BarSolidPx.png?fileID=2800000&amp;guid=01014b44aedfc2643b822a39ff9ae028&amp;type=3#BarSolidPx" name="Image" style="width: 100%; height: 100%; align-self: center; flex-direction: row; justify-content: space-evenly; align-content: center; align-items: center; flex-wrap: nowrap;">
                    <ui:Button text="" name="OnOffSound" icon-image="" style="width: 22%; height: 50%; background-color: rgba(188, 188, 188, 0); cursor: initial; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);">
                        <ui:Image source="project://database/Assets/UI/NewUIHud/BtnOff1Px.png?fileID=2800000&amp;guid=1898b563b98a8a6419a01d1bd93cc05a&amp;type=3#BtnOff1Px" language-direction="Inherit" uv="0,0,1,1" style="width: 100%; height: 100%; -unity-background-image-tint-color: rgba(255, 255, 255, 0); border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0);"/>
                    </ui:Button>
                    <ui:Button text="" name="Config" icon-image="" style="width: 22%; height: 50%; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);">
                        <ui:Image source="project://database/Assets/UI/NewUIHud/BtnOff2Px.png?fileID=2800000&amp;guid=35c26a52b9ba28643a7e687762ec484f&amp;type=3#BtnOff2Px" language-direction="Inherit" uv="0,0,1,1" style="width: 100%; height: 100%;"/>
                    </ui:Button>
                    <ui:Button text="" name="events" icon-image="" style="width: 22%; height: 50%; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);">
                        <ui:Image source="project://database/Assets/UI/NewUIHud/BtnOff3Px.png?fileID=2800000&amp;guid=3b0ce90a1100280499515b87c67e1a0e&amp;type=3#BtnOff3Px" language-direction="Inherit" uv="0,0,1,1" style="width: 100%; height: 100%;"/>
                    </ui:Button>
                    <ui:Button text="" name="Shop" icon-image="" style="width: 22%; height: 50%; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);">
                        <ui:Image source="project://database/Assets/UI/NewUIHud/BtnOff4Px.png?fileID=2800000&amp;guid=b8f852068c0f53743a07bf73ef6f09f9&amp;type=3#BtnOff4Px" language-direction="Inherit" uv="0,0,1,1" style="width: 100%; height: 100%;"/>
                    </ui:Button>
                </ui:Image>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
