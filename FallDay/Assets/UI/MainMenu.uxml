                <ui:Button text="Iniciar" name="Play" class="menu-button" style="opacity: 1; margin-left: 4px; margin-bottom: 30px; top: 19px; align-self: center; width: 119px; position: absolute; left: 43px; transform-origin: center; rotate: -20deg; display: flex; visibility: visible; overflow: visible; -unity-background-image-tint-color: rgba(255, 255, 255, 0); background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);"/>
                <ui:Button text="Config&#10;" name="Config" class="menu-button" style="margin-top: 0; align-self: center; width: 75px; position: absolute; top: 92px; left: 63px; height: 71px; background-color: rgba(188, 188, 188, 0); -unity-background-image-tint-color: rgba(255, 255, 255, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);"/>
                <ui:Button text="Credits" name="Credits" class="menu-button" style="position: absolute; top: 195px; left: 64px; -unity-background-image-tint-color: rgba(255, 255, 255, 0); background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); width: 74px; rotate: 27deg;"/>
