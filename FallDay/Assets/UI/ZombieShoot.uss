.bulletDisplay {
    margin-top: 4px;
    margin-right: 4px;
    margin-bottom: 4px;
    margin-left: 4px;
    background-color: rgba(0, 0, 0, 0.8);
    width: 60px;
    height: 66px;
}

.shitBullet {
    background-color: rgba(245, 245, 245, 0);
    background-image: url("project://database/Assets/Sprites/BulletButtons/SmallBulletRenderedCrushedShadowed.png?fileID=2800000&guid=751514017931a5246986e94b189d3aaf&type=3#SmallBulletRenderedCrushedShadowed");
}

.goodBullet {
    background-color: rgba(245, 245, 245, 0);
    background-image: url("project://database/Assets/Sprites/BulletButtons/BulletRenderedCrushedShadowedAse.png?fileID=2800000&guid=b93b692265ed1d3409ca06cf763e32d4&type=3#BulletRenderedCrushedShadowedAse");
}

.bulletButton {
    flex-direction: row;
    width: 57px;
    height: 52px;
}

.epicBullet {
    background-color: rgba(255, 255, 255, 0);
    background-image: url("project://database/Assets/Sprites/BulletButtons/EpicBulletBitCrushedShadowed.png?fileID=2800000&guid=0ddf7567a1a6ae14ab387c08bd995835&type=3#EpicBulletBitCrushedShadowed");
}

.zombieSpot {
    background-color: rgb(163, 163, 163);
    -unity-background-scale-mode: stretch-to-fill;
    border-top-width: 30px;
    border-right-width: 30px;
    border-bottom-width: 30px;
    border-left-width: 30px;
}

.zombieSpotOccupied {
    background-color: rgb(13, 101, 0);
}

.aimed {
    scale: 0.5 0.5;
}

.used {
    scale: 0.9 0.9;
    -unity-background-image-tint-color: rgb(255, 252, 184);
}
