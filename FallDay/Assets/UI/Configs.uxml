<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1;">
        <ui:VisualElement style="flex-grow: 1;">
            <ui:Label text="Options" style="align-self: center; font-size: 32px; margin-top: 25px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="VisualElement" style="flex-grow: 1;">
            <ui:Slider label="Master Volume" value="1" high-value="2" enabled="true" name="MasterVolume" low-value="0.0001" fill="true" focusable="true" style="display: flex; overflow: hidden; visibility: visible; -unity-font-style: bold;"/>
            <ui:Slider label="Music" value="1" high-value="2" name="MusicVolume" fill="true" low-value="0.0001" style="margin-top: 2px; visibility: visible; overflow: hidden;"/>
            <ui:Button text="Return" name="Return" style="width: 92px; height: 53px; left: 88px; top: 15px;"/>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1;"/>
    </ui:VisualElement>
</ui:UXML>
