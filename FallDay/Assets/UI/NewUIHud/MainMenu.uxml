            <ui:Label text="Estes são os tipos de Blocos que você pode utilizar no jogo" name="Tutorial2Text" style="font-size: 73px; -unity-text-align: upper-center; position: relative; bottom: -390px; white-space: normal;"/>
            <ui:Image source="project://database/Assets/Sprites/BulletButtons/BulletRenderedCrushedShadowedAse.png?fileID=2800000&amp;guid=b93b692265ed1d3409ca06cf763e32d4&amp;type=3#BulletRenderedCrushedShadowedAse" style="position: absolute; top: 800px;"/>
            <ui:Label text="Bala basica - Causa mais dano a inimigos em alcance medio" style="position: absolute; top: 800px; left: 200px; width: 846px; font-size: 48px; white-space: normal;"/>
            <ui:Image source="project://database/Assets/Sprites/BulletButtons/EpicBulletBitCrushedShadowed.png?fileID=2800000&amp;guid=0ddf7567a1a6ae14ab387c08bd995835&amp;type=3#EpicBulletBitCrushedShadowed" style="position: absolute; top: 975px;"/>
            <ui:Label text="Bala Avançada - Causa mais dano a &#10;inimigos de alcance longo" style="position: absolute; white-space: normal; font-size: 48px; top: 975px; left: 200px;"/>
            <ui:Image source="project://database/Assets/Sprites/BulletButtons/SmallBulletRenderedCrushedShadowed.png?fileID=2800000&amp;guid=751514017931a5246986e94b189d3aaf&amp;type=3#SmallBulletRenderedCrushedShadowed" style="position: absolute; top: 1150px;"/>
            <ui:Label text="Bala mediana - Causa mais dano a&#10;inimigos de alcance curto" style="position: absolute; white-space: normal; font-size: 48px; top: 1150px; left: 200px;"/>
            <ui:Image source="project://database/Assets/TestIcons/Plus%201st%2064px.png?fileID=2800000&amp;guid=e2831f4e84c622842a61874ac3aef37c&amp;type=3#Plus 1st 64px" scale-mode="ScaleToFit" style="position: absolute; top: 1325px; height: 124px; width: 158px;"/>
            <ui:Label text="Kit de cura - Permite curar 1 de vida&#10;por bloco combinado" style="position: absolute; white-space: normal; font-size: 48px; top: 1325px; left: 200px;"/>
            <ui:Image source="project://database/Assets/TestIcons/Warning%201st%2064px.png?fileID=2800000&amp;guid=b080d098ba9d5fa42bfc15b5e66ffc25&amp;type=3#Warning 1st 64px" style="position: absolute; top: 1500px; height: 131px; width: 164px;"/>
            <ui:Label text="Afastamento - Faz você se afastar&#10;dos zumbis" style="position: absolute; white-space: normal; font-size: 48px; top: 1500px; left: 200px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="TutorialWindow3" style="flex-grow: 1; position: absolute; height: 2334px; width: 1077px; background-color: rgb(226, 217, 201); display: none;">
            <ui:Label text="Apos derrotar todos os zumbis de uma fase você pode escolher qual caminho escolher, cada um com uma recompensa a escolher sendo elas:" name="Tutorial3Text" style="font-size: 73px; -unity-text-align: upper-center; position: relative; bottom: -390px; white-space: normal;"/>
            <ui:Image source="project://database/Assets/TestIcons/Blue%20Coin%201st%2064px.png?fileID=2800000&amp;guid=31ecc55734017ce4a907e475759abd84&amp;type=3#Blue Coin 1st 64px" style="position: absolute; top: 1250px; left: 750px; height: 184px; width: 190px;"/>
            <ui:Label text="Sala &#10;de Cura" style="position: absolute; top: 1470px; left: 155px; font-size: 40px; white-space: normal; -unity-text-align: upper-center;"/>
            <ui:Label text="OU" style="position: absolute; top: 1361px; left: 534px; font-size: 40px;"/>
            <ui:Image source="project://database/Assets/TestIcons/Plus%201st%2064px.png?fileID=2800000&amp;guid=e2831f4e84c622842a61874ac3aef37c&amp;type=3#Plus 1st 64px" style="position: absolute; top: 1250px; left: 150px; height: 184px; width: 191px;"/>
            <ui:Label text="Sala &#10;de Dinheiro" style="position: absolute; top: 1487px; left: 725px; font-size: 40px; -unity-text-align: upper-center; white-space: normal;"/>
