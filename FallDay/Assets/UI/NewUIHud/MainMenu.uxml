        <ui:VisualElement name="TutorialWindow4" style="flex-grow: 1; position: absolute; height: 2334px; width: 1077px; background-color: rgb(226, 217, 201); display: none;">
            <ui:Label text="Esta é a sua barra de vida" name="Tutorial4Text" style="font-size: 73px; -unity-text-align: upper-center; position: relative; bottom: -390px; white-space: normal;"/>
            <ui:Image source="project://database/Assets/HealthSystem/Hp_Sprite.png?fileID=2800000&amp;guid=e7ea2426b7b8b104ea3d19181f0f4d35&amp;type=3#Hp_Sprite" scale-mode="StretchToFill" style="top: 834px; width: 832px; position: absolute; left: 133px;"/>
            <ui:Label text="Para cada zumbi que te atacar, você perdera vida baseada em qual zumbi te ataco, tome cuidado com aqueles que causam muito dano " name="Tutorial4Text" style="font-size: 73px; -unity-text-align: upper-center; position: absolute; bottom: 804px; white-space: normal; left: 88px; width: 902px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="TutorialWindow5" style="flex-grow: 1; position: absolute; height: 2334px; width: 1077px; background-color: rgb(226, 217, 201); display: none;">
            <ui:Label text="Vamos falar um pouco sobre os zumbis, enquanto o jogo permite você atirar em zumbis aleatorios você pode selecionar quais zumbis ataca utilizando a tela de icones em cima dos blocos de combinação." name="Tutorial6Text" style="font-size: 60px; -unity-text-align: upper-center; position: relative; bottom: -390px; white-space: normal;"/>
            <ui:Label text="Basta clicar e o jogo imediatamente começara a focar no zumbi selecionado!" name="Tutorial6Text" style="font-size: 60px; -unity-text-align: upper-center; position: relative; bottom: -390px; white-space: normal;"/>
            <ui:Image source="project://database/Assets/UI/NewUIHud/Icons_menu/BarSolidPx.png?fileID=21300000&amp;guid=01014b44aedfc2643b822a39ff9ae028&amp;type=3#BarSolidPx" style="position: absolute; top: 1072px; left: 88px; width: 927px; height: 613px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="TutorialWindow6" style="flex-grow: 1; position: absolute; height: 2334px; width: 1077px; background-color: rgb(226, 217, 201); display: none;">
            <ui:Label text="Parabens você completou o Tutorial!" name="Tutorial5Text" style="font-size: 73px; -unity-text-align: upper-center; position: relative; bottom: -390px; white-space: normal; top: 609px;"/>
