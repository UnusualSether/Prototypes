:root {
}

.unity-button:active {
    -unity-background-image-tint-color: rgb(183, 183, 183);
}

.unity-button {
}

.pause_panel_off {
    display: none;
    opacity: 0;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    background-color: rgba(0, 0, 0, 0.76);
    position: absolute;
    transition-property: opacity;
    transition-timing-function: linear;
    transition-duration: 0.2s;
}

.pause_panel_on {
    display: flex;
    opacity: 1;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    background-color: rgba(0, 0, 0, 0.76);
    position: absolute;
    transition-property: opacity;
    transition-timing-function: linear;
    transition-duration: 0.2s;
}

.screen_setting_off {
    flex-grow: 1;
    width: 100%;
    height: 80%;
    position: absolute;
    top: auto;
    left: auto;
    align-self: center;
    flex-direction: column;
    align-content: center;
    justify-content: space-evenly;
    align-items: center;
    opacity: 0;
    display: none;
    transition-property: opacity;
    transition-timing-function: linear;
    transition-duration: 0.2s;
}

.screen_button_on {
    flex-grow: 1;
    width: 100%;
    height: 80%;
    position: absolute;
    top: auto;
    left: auto;
    align-self: center;
    flex-direction: column;
    align-content: center;
    justify-content: space-evenly;
    align-items: center;
    opacity: 1;
    display: flex;
    transition-property: opacity;
    transition-timing-function: linear;
    transition-duration: 0.2s;
}

.screen_button_off {
    flex-grow: 1;
    width: 100%;
    height: 80%;
    position: absolute;
    top: auto;
    left: auto;
    align-self: center;
    flex-direction: column;
