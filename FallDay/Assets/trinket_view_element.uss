#trinket_sprite {
    width: 50%;
    aspect-ratio: 1;
    margin-bottom: 3%;
}

#TextPanel {
    flex-direction: column;
    align-items: center;
    width: 100%;
}

#trinket_name {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    width: 90%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

#trinket_desc {
    -unity-text-align: middle-center;
    width: 90%;
    white-space: normal;
    margin-top: 2%;
}

#trinket_toggle {
    margin-top: 3%;
    align-self: center;
}

#trinket_toggle .unity-toggle__input {
    width: 32px;
    height: 32px;
}

#trinket_toggle .unity-toggle__checkmark {
    width: 28px;
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
}

#trinket_toggle .unity-toggle__checkmark {
    background-image: none;
    border-width: 2px;
    border-color: rgb(140, 133, 121);
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
}

#trinket_toggle:checked .unity-toggle__checkmark {
    background-image: url("project://database/Assets/UI/GearPixel.png?fileID=21300000&guid=dc9d8567e61ed1b40a4a53cdf1d0e9d0&type=3#GearPixel");
    background-color: rgb(95, 107, 62);
    border-color: rgb(95, 107, 62);
}

#trinket_view_element.equipped {
    background-color: rgba(95, 107, 62, 0.15);
    border-left-width: 3px;
    border-left-color: rgb(95, 107, 62);
}

.trinked_nothing_set {
    flex-grow: 1;
    width: 600px;
    height: 800px;
    background-color: rgba(227, 218, 201, 0.8);
    align-items: center;
    justify-content: space-between;
    align-self: center;
    align-content: center;
    margin-top: 0%;
    margin-right: 100px;
    margin-bottom: 0%;
    margin-left: 100px;
    flex-basis: 90%;
    flex-direction: column;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-font-definition: url("project://database/Assets/TRAFFIC6.TTF?fileID=12800000&guid=f07357d919f588b48b520990911ee828&type=3#TRAFFIC6");
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
    letter-spacing: 0;
    -unity-text-align: middle-center;
}

.trinked_set {
    background-color: rgba(16, 168, 51, 0.8);
}
