#trinket_sprite {
    width: 50%;
    aspect-ratio: 1;
    margin-bottom: 3%;
}

#TextPanel {
    flex-direction: column;
    align-items: center;
    width: 100%;
}

#trinket_name {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    width: 90%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

#trinket_desc {
    -unity-text-align: middle-center;
    width: 90%;
    white-space: normal;
    margin-top: 2%;
}

#trinket_toggle {
    margin-top: 3%;
    align-self: center;
}

#trinket_toggle .unity-toggle__input {
    width: 32px;
    height: 32px;
}

#trinket_toggle .unity-toggle__checkmark {
    width: 28px;
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
}

#trinket_toggle .unity-toggle__checkmark {
    background-image: none;
    border-width: 2px;
    border-color: rgb(140, 133, 121);
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
}

#trinket_toggle:checked .unity-toggle__checkmark {
    background-image: url("project://database/Assets/UI/GearPixel.png");
    background-color: rgb(95, 107, 62);
    border-color: rgb(95, 107, 62);
}

#trinket_view_element.equipped {
    background-color: rgba(95, 107, 62, 0.15);
    border-left-width: 3px;
    border-left-color: rgb(95, 107, 62);
}
