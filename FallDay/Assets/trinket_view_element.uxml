<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/trinket_view_element.uss?fileID=7433441132597879392&amp;guid=23986a1d5a5043a42b677204438b9b7c&amp;type=3#trinket_view_element"/>
    <ui:VisualElement name="trinket_view_element" class="trinked_nothing_set">
        <ui:Image name="trinket_sprite" style="width: 80%; height: 40%; -unity-text-align: middle-center;"/>
        <ui:VisualElement name="TextPanel" style="flex-grow: 1; width: 95%; height: 40%; align-self: center; justify-content: space-around; align-items: center; -unity-text-align: middle-center;">
            <ui:Label text="Nome do item" name="trinket_name" style="width: 90%; height: 30%; font-size: 50%; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/TRAFFIC6.TTF?fileID=12800000&amp;guid=f07357d919f588b48b520990911ee828&amp;type=3#TRAFFIC6&quot;); -unity-text-align: middle-center; text-overflow: ellipsis; white-space: normal; margin-left: 0; margin-right: 0; margin-bottom: 0; padding-right: 0; padding-left: 0; padding-bottom: 0; padding-top: 0; margin-top: 0;"/>
            <ui:Label text="descrição totalmente fora de contexto que não póde ser apicado" name="trinket_desc" style="width: 90%; height: 60%; -unity-font-definition: url(&quot;project://database/Assets/TRAFFIC6.TTF?fileID=12800000&amp;guid=f07357d919f588b48b520990911ee828&amp;type=3#TRAFFIC6&quot;); font-size: 30%; -unity-text-align: middle-center; text-overflow: clip; white-space: normal; margin-right: 0; margin-left: 0; margin-bottom: 0; margin-top: 1%; padding-bottom: 0; padding-right: 0; padding-top: 0; padding-left: 0;"/>
        </ui:VisualElement>
        <ui:Toggle label="" name="trinket_toggle" focusable="true" value="false" toggle-on-label-click="true" style="height: 20%; width: 100%; flex-direction: column; align-items: center; align-self: center; justify-content: space-around; align-content: stretch; padding-top: 10%; padding-right: 10%; padding-bottom: 10%; padding-left: 10%; -unity-text-align: upper-center; background-color: rgba(26, 18, 12, 0.94); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; margin-bottom: 0;"/>
    </ui:VisualElement>
</ui:UXML>
