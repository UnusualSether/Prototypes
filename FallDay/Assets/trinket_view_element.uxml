            <ui:Label text="Nome do item" name="trinket_name" style="width: 95%; height: 30%; font-size: 55%; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/TRAFFIC6.TTF?fileID=12800000&amp;guid=f07357d919f588b48b520990911ee828&amp;type=3#TRAFFIC6&quot;); -unity-text-align: middle-center; text-overflow: ellipsis; white-space: normal; margin-left: 0; margin-right: 0; margin-bottom: 0; padding-right: 0; padding-left: 0; padding-bottom: 0; padding-top: 0; margin-top: 0;"/>
